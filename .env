APP_PORT=8082
APP_ENV=development
APP_NAME=product-service
WEB_PREFORK=false
LOG_LEVEL=debug

JWT_SECRET_KEY=super-secret-key

GATEWAY_SECRET_KEY=veggo-gateway-secret-key
REQUEST_API_GATEWAY=true

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=root
DATABASE_PASSWORD=root_password
DATABASE_NAME=veggo_product_service
DATABASE_MAX_OPEN_CONNECTION=25
DATABASE_MAX_IDLE_CONNECTION=10

KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_GROUP_ID=veggo-user-service-group
KAFKA_PRODUCER_ENABLED=true

TOPIC_PRODUCT_UPDATE_STOCK_NAME="product-update-stock"
TOPIC_PRODUCT_PUBLISH_NAME="product-publish"
TOPIC_PRODUCT_DELETE="product-delete"

MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=veggo-user-service
MINIO_USE_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=password
